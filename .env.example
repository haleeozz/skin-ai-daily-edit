# Server-only credentials. Never commit .env.local or use NEXT_PUBLIC_ for keys.
YOUCAM_API_KEY=
ENABLE_LIVE_ANALYSIS=false
# Durable global reservation cap, including uncertain submissions. 3 per session.
MAX_LIVE_ANALYSES=20
# Stable random value, at least 32 characters; required for hosted live analysis.
SESSION_SECRET=
# A connected private Vercel Blob store supplies this automatically on Vercel.
BLOB_READ_WRITE_TOKEN=
# Random maintenance credential for the scheduled daily cleanup.
CRON_SECRET=
# Optional: restrict mutation requests to one exact origin.
PUBLIC_APP_ORIGIN=
